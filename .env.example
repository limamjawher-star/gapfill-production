# GEMINI_API_KEY: Server-side secret for Gemini AI strategy generation.
# Never expose this key in browser/client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public canonical URL where GapFill is hosted (used for health checks and server redirects).
APP_URL="MY_APP_URL"

# Supabase Public Configuration (safe for browser when Row-Level Security is enabled)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Server-Only Secret (required later for server-side Edge/API secret vault & admin tasks; NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Next.js dev runtime flag used in containerized environments (set "true" to disable webpack file watching)
DISABLE_HMR="false"
